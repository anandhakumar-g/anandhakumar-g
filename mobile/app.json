{
  "expo": {
    "name": "Single Point",
    "slug": "single-point",
    "scheme": "singlepoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.singlepoint.app" },
    "android": { "package": "com.singlepoint.app" },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "Allow Single Point to attach your location to a service request." }],
      ["expo-image-picker", { "photosPermission": "Allow Single Point to attach photos to your tickets." }],
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": false }
  }
}
